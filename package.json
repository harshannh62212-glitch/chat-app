{
  "name": "chat-app",
  "version": "1.0.0",
  "description": "A real-time chat application with servers, DMs, and content filtering",
  "main": "server.js",
  "scripts": {
    "start": "node --max-old-space-size=16384 server.js",
    "dev": "node --max-old-space-size=16384 server.js",
    "cluster": "NODE_ENV=production node --max-old-space-size=16384 server.js",
    "client": "cd frontend && npm run dev",
    "build": "cd frontend && npm install --include=dev && npm run build && cd .. && mkdir -p public dist && cp -r frontend/dist/* public/ && cp -r frontend/dist/* dist/ && cp frontend/dist/index.html index.html",
    "install-all": "npm install && cd frontend && npm install",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "chat",
    "real-time",
    "messaging"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^2.7.0",
    "pg": "^8.22.0",
    "pino": "^9.3.0",
    "redis": "^4.6.10",
    "@socket.io/redis-adapter": "^8.3.0",
    "socket.io": "^4.8.3",
    "twilio": "^4.19.2"
  }
}
