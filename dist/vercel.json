{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://chat-app-hqji.onrender.com/api/:path*"
    },
    {
      "source": "/ping",
      "destination": "https://chat-app-hqji.onrender.com/ping"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://chat-app-hqji.onrender.com/socket.io/:path*"
    },
    {
      "source": "/((?!assets/|favicon.png).*)",
      "destination": "/index.html"
    }
  ]
}
