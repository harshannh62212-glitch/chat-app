{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://starter-taste-lamp-wit.trycloudflare.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://starter-taste-lamp-wit.trycloudflare.com/socket.io/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
