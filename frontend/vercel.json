{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://starter-taste-lamp-wit.trycloudflare.com/api/$1"
    },
    {
      "src": "/socket.io/(.*)",
      "dest": "https://starter-taste-lamp-wit.trycloudflare.com/socket.io/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
