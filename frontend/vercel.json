{
  "routes": [
    {
      "src": "/api/resolve-tunnel",
      "dest": "/api/resolve-tunnel"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://springfield-definition-bin-configurations.trycloudflare.com/api/$1"
    },
    {
      "src": "/socket.io/(.*)",
      "dest": "https://springfield-definition-bin-configurations.trycloudflare.com/socket.io/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
