{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/"
    },
    {
      "source": "/ping",
      "destination": "/api/ping"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}