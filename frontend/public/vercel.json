{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://phentermine-novelty-toolbar-respective.trycloudflare.com/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://phentermine-novelty-toolbar-respective.trycloudflare.com/socket.io/$1"
    },
    {
      "source": "/ping",
      "destination": "https://phentermine-novelty-toolbar-respective.trycloudflare.com/ping"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
