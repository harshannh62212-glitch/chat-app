{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/resolve-tunnel",
      "destination": "/api/resolve-tunnel.js"
    },
    {
      "source": "/api/minecraft-status",
      "destination": "/api/minecraft-status.js"
    },
    {
      "source": "/api/minecraft/status",
      "destination": "/api/minecraft-status.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/ping",
      "destination": "/api/ping.js"
    },
    {
      "source": "/((?!assets/|favicon.png|api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
