{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://chat-app-hqji.onrender.com/api/$1"
    },
    {
      "source": "/ping",
      "destination": "https://chat-app-hqji.onrender.com/ping"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://chat-app-hqji.onrender.com/socket.io/$1"
    },
    {
      "source": "/((?!api|socket.io|assets|favicon.png).*)",
      "destination": "/index.html"
    }
  ]
}
