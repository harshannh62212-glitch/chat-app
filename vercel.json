{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/resolve-tunnel",
      "destination": "/api/resolve-tunnel"
    },
    {
      "source": "/api/minecraft-status",
      "destination": "/api/minecraft-status"
    },
    {
      "source": "/api/minecraft/status",
      "destination": "/api/minecraft-status"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://chat-app-backend-render.onrender.com/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://chat-app-backend-render.onrender.com/socket.io/$1"
    },
    {
      "source": "/ping",
      "destination": "https://chat-app-backend-render.onrender.com/ping"
    },
    {
      "source": "/((?!assets/|favicon.png|api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
