{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/ping",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!assets/|favicon.png).*)",
      "destination": "/index.html"
    }
  ]
}
