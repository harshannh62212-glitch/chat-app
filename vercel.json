{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://specification-guide-software-automation.trycloudflare.com/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://specification-guide-software-automation.trycloudflare.com/socket.io/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
