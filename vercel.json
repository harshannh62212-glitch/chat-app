{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://dry-horses-stare.loca.lt/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://dry-horses-stare.loca.lt/socket.io/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
