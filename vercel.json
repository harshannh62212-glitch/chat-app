{
  "rewrites": [
    {
      "source": "/api/resolve-tunnel",
      "destination": "/api/resolve-tunnel"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://garlic-survey-closed-volunteer.trycloudflare.com/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://garlic-survey-closed-volunteer.trycloudflare.com/socket.io/$1"
    },
    {
      "source": "/ping",
      "destination": "https://garlic-survey-closed-volunteer.trycloudflare.com/ping"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
